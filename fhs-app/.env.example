APP_NAME=FHS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://fhs.test:7080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Comma-separated list of emails treated as administrators. Matching is
# case-insensitive. Users must still register/log in normally — this only
# grants the admin capability to accounts with these addresses.
ADMIN_EMAILS=admin@fhs.test

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Docker ---------------------------------------------------------------
# Host ports published by docker-compose. Change these if they collide with
# another project running locally.
APP_PORT=7080
VITE_PORT=5173
# Host-side ports for Redis / RedisInsight / Postgres. These differ from the
# defaults so the stack can run alongside other local projects (e.g. SitePulse
# on 6379/5540). They only affect what you connect to *from the host* — inside
# the compose network the services still use their standard ports.
REDIS_HOST_PORT=6380
REDIS_INSIGHT_PORT=5541
DB_HOST_PORT=5433
# Match your host user so files written from the containers stay yours:
#   UID=$(id -u) GID=$(id -g)
UID=501
GID=20
XDEBUG_MODE=off

# --- Database (PostgreSQL) ------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fhs
DB_USERNAME=fhs
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# --- Redis ----------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=secret
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
